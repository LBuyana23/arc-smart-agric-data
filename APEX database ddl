-- ======================================================
-- TABLE: ALERTS
-- ======================================================
CREATE TABLE "WKSP_G3DATA"."ALERTS" (
    "ID" NUMBER GENERATED BY DEFAULT AS IDENTITY
        MINVALUE 1 MAXVALUE 9999999999999999999999999999
        INCREMENT BY 1 START WITH 1 CACHE 20
        NOORDER NOCYCLE NOKEEP NOSCALE
        NOT NULL ENABLE,
    "DEVICE_ID" NUMBER NOT NULL ENABLE,
    "ALERT_TIME" TIMESTAMP (6) DEFAULT SYSTIMESTAMP,
    "ALERT_TYPE" VARCHAR2(100) NOT NULL ENABLE,
    "MESSAGE" VARCHAR2(200),
    "SEVERITY" VARCHAR2(10) NOT NULL ENABLE,
    "STATUS" VARCHAR2(20) DEFAULT 'new' NOT NULL ENABLE,
    
    CONSTRAINT "CHK_ALERT_SEVERITY" CHECK (severity IN ('INFO', 'WARNING', 'CRITICAL')) ENABLE,
    CONSTRAINT "CHK_ALERT_STATUS" CHECK (status IN ('new', 'acknowledged', 'resolved')) ENABLE,
    CONSTRAINT "FK_ALERT_DEVICE" FOREIGN KEY ("DEVICE_ID")
        REFERENCES "WKSP_G3DATA"."DEVICES" ("ID"),
    PRIMARY KEY ("ID")
) TABLESPACE "APEX_BIGFILE_INSTANCE_TBS2";


-- ======================================================
-- TABLE: AUDIT_LOG
-- ======================================================
CREATE TABLE "WKSP_G3DATA"."AUDIT_LOG" (
    "ID" NUMBER GENERATED BY DEFAULT AS IDENTITY
        MINVALUE 1 MAXVALUE 9999999999999999999999999999
        INCREMENT BY 1 START WITH 1 CACHE 20
        NOORDER NOCYCLE NOKEEP NOSCALE
        NOT NULL ENABLE,
    "DEVICE_ID" NUMBER,
    "EVENT_TIME" TIMESTAMP (6) DEFAULT SYSTIMESTAMP,
    "EVENT_TYPE" VARCHAR2(50) NOT NULL ENABLE,
    "DESCRIPTION" VARCHAR2(200) NOT NULL ENABLE,
    "SOURCE" VARCHAR2(50),
    "SEVERITY" VARCHAR2(10),
    
    CONSTRAINT "CHK_AUDIT_SEVERITY" CHECK (severity IN ('INFO', 'WARN', 'ERROR')) ENABLE,
    CONSTRAINT "FK_AUDIT_DEVICE" FOREIGN KEY ("DEVICE_ID")
        REFERENCES "WKSP_G3DATA"."DEVICES" ("ID"),
    PRIMARY KEY ("ID")
) TABLESPACE "APEX_BIGFILE_INSTANCE_TBS2";


-- ======================================================
-- TABLE: CROP
-- ======================================================
CREATE TABLE "WKSP_G3DATA"."CROP" (
    "CROP_ID" VARCHAR2(50),
    "LABEL" VARCHAR2(100),
    "RECOMMENDATION" VARCHAR2(255),
    "IMAGE_URL" VARCHAR2(255),
    "MODEL_NAME" VARCHAR2(50),
    "CONFIDENCE" VARCHAR2(10),
    "GROUP_ID" NUMBER
) TABLESPACE "APEX_BIGFILE_INSTANCE_TBS2";


-- ======================================================
-- TABLE: DEVICES
-- ======================================================
CREATE TABLE "WKSP_G3DATA"."DEVICES" (
    "ID" NUMBER GENERATED BY DEFAULT AS IDENTITY
        MINVALUE 1 MAXVALUE 9999999999999999999999999999
        INCREMENT BY 1 START WITH 1 CACHE 20
        NOORDER NOCYCLE NOKEEP NOSCALE
        NOT NULL ENABLE,
    "DEVICE_UID" VARCHAR2(50) NOT NULL ENABLE,
    "NAME" VARCHAR2(100),
    "LOCATION" VARCHAR2(100),
    "STATUS" VARCHAR2(20) DEFAULT 'offline' NOT NULL ENABLE,
    "LAST_SEEN" TIMESTAMP (6),
    "CREATED_AT" TIMESTAMP (6) DEFAULT SYSTIMESTAMP,
    
    CONSTRAINT "CHK_DEVICE_STATUS" CHECK (status IN ('online', 'offline', 'error', 'maintenance')) ENABLE,
    PRIMARY KEY ("ID"),
    UNIQUE ("DEVICE_UID")
) TABLESPACE "APEX_BIGFILE_INSTANCE_TBS2";


