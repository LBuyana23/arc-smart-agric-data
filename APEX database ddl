-- ======================================================
-- TABLE: IRRIGATION_SETTINGS
-- ======================================================
CREATE TABLE "WKSP_G3DATA"."IRRIGATION_SETTINGS" (
    "DEVICE_UID" VARCHAR2(50),
    "CRITICAL_LOW_THRESHOLD" NUMBER(5,2) DEFAULT 40.0,
    "CRITICAL_HIGH_THRESHOLD" NUMBER(5,2) DEFAULT 80.0,
    "AUTOMATED_MODE_ENABLED" NUMBER(1,0) DEFAULT 1,
    "ALLOW_MANUAL_OVERRIDE_AT_ANY_MOISTURE" NUMBER(1,0) DEFAULT 1,
    "LAST_UPDATED" TIMESTAMP (6) DEFAULT CURRENT_TIMESTAMP,
    
    CONSTRAINT "CHK_SETTINGS_THRESHOLDS" CHECK (critical_low_threshold < critical_high_threshold) ENABLE,
    CONSTRAINT "CHK_SETTINGS_AUTOMATED" CHECK (automated_mode_enabled IN (0, 1)) ENABLE,
    CONSTRAINT "CHK_SETTINGS_MANUAL_OVERRIDE" CHECK (allow_manual_override_at_any_moisture IN (0, 1)) ENABLE,
    PRIMARY KEY ("DEVICE_UID")
) TABLESPACE "APEX_BIGFILE_INSTANCE_TBS2";


-- ======================================================
-- TABLE: PUMP_SCHEDULE
-- ======================================================
CREATE TABLE "WKSP_G3DATA"."PUMP_SCHEDULE" (
    "ID" NUMBER GENERATED BY DEFAULT AS IDENTITY
        MINVALUE 1 MAXVALUE 9999999999999999999999999999
        INCREMENT BY 1 START WITH 1 CACHE 20
        NOORDER NOCYCLE NOKEEP NOSCALE
        NOT NULL ENABLE,
    "DEVICE_ID" NUMBER NOT NULL ENABLE,
    "START_TIME_OF_DAY" VARCHAR2(8) NOT NULL ENABLE,
    "DURATION_MIN" NUMBER NOT NULL ENABLE,
    "REPEAT_DAYS" VARCHAR2(30),
    "IS_ACTIVE" NUMBER(1,0) DEFAULT 1 NOT NULL ENABLE,
    "LAST_RUN" TIMESTAMP (6),
    "SCHEDULE_NAME" VARCHAR2(200),
    
    CONSTRAINT "CHK_SCHEDULE_IS_ACTIVE" CHECK (is_active IN (0, 1)) ENABLE,
    CONSTRAINT "CHK_START_TIME_FORMAT" CHECK (REGEXP_LIKE(start_time_of_day, '^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$')) ENABLE,
    CONSTRAINT "FK_SCHEDULE_DEVICE" FOREIGN KEY ("DEVICE_ID")
        REFERENCES "WKSP_G3DATA"."DEVICES" ("ID"),
    PRIMARY KEY ("ID")
) TABLESPACE "APEX_BIGFILE_INSTANCE_TBS2";


-- ======================================================
