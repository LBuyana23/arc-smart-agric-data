BEGIN
    DELETE FROM WKSP_G3DATA.TELEMETRY_DATA
    WHERE ID IN (
        SELECT ID FROM WKSP_G3DATA.TELEMETRY_DATA
        ORDER BY TIMESTAMP ASC
        FETCH FIRST 200 ROWS ONLY
    );

    DELETE FROM WKSP_G3DATA.SOIL
    WHERE ROWID IN (
        SELECT ROWID FROM WKSP_G3DATA.SOIL
        ORDER BY CREATED_AT ASC
        FETCH FIRST 200 ROWS ONLY
    );

    DELETE FROM WKSP_G3DATA.GREENHOUSE_G9
    WHERE ROWID IN (
        SELECT ROWID FROM WKSP_G3DATA.GREENHOUSE_G9
        ORDER BY TIMESTAMP_READING ASC
        FETCH FIRST 200 ROWS ONLY
    );

    DELETE FROM WKSP_G3DATA.GREENHOUSE_G1
    WHERE ROWID IN (
        SELECT ROWID FROM WKSP_G3DATA.GREENHOUSE_G1
        ORDER BY TIMESTAMP_READING ASC
        FETCH FIRST 200 ROWS ONLY
    );

    DELETE FROM WKSP_G3DATA.CROP
    WHERE ROWID IN (
        SELECT ROWID FROM WKSP_G3DATA.CROP
        FETCH FIRST 200 ROWS ONLY
    );

    COMMIT;
END;
